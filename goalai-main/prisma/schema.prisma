generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String    @id @db.Uuid
  name                String?   @map("full_name")
  email               String?   @unique
  isGuest             Boolean   @default(false)
  northStar           String?   @map("north_star")
  valueSkill          String?   @map("value_skill")
  frictionTrigger     String    @default("OVERTHINKING")
  dailyWindowMinutes  Int       @default(30)
  internalTrustScore  Float     @default(0.5)
  trustScore          Int       @default(500) @map("trust_score")
  loadMultiplier      Float     @default(1.0)
  consecutiveFullDays Int       @default(0)
  day0CompletedAt     DateTime?
  surveyCompletedAt   DateTime?
  lastOpenedAt        DateTime?
  integrityHash       String?   @map("integrity_hash")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt

  tasks       Task[]
  trustEvents TrustEvent[]

  @@map("gan_users")
}

model Task {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  date        String
  type        String    @default("EXECUTE")
  title       String
  description String
  duration    Int       @default(30)
  hook        String    @default("")
  completed   Boolean   @default(false)
  completedAt DateTime?
  skipped     Boolean   @default(false)
  orderIndex  Int       @default(0)
  isDay0      Boolean   @default(false)
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model TrustEvent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  type      String
  value     Float
  date      String
  metadata  String?
  integrityHash String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}
